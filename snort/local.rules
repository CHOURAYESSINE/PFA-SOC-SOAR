# SOC demo local Snort rules
# Network: HOME_NET is configured by snort.debian.conf/service.

# Basic visibility / ping
alert icmp any any -> $HOME_NET any (msg:"ICMP ping detected"; itype:8; sid:100001; rev:2;)
alert icmp any any -> $HOME_NET any (msg:"ICMP ping flood detected"; itype:8; threshold:type threshold, track by_src, count 20, seconds 5; sid:1001010; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"PING vers Metasploitable detecte"; itype:8; sid:1000002; rev:2;)

# Recon / scans
alert tcp any any -> $HOME_NET any (msg:"TCP SYN port scan detected"; flags:S; threshold:type threshold, track by_src, count 20, seconds 5; sid:1001020; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Nmap SYN scan detected"; flags:S; threshold:type threshold, track by_src, count 20, seconds 2; sid:1001; rev:2;)

# Brute force style thresholds
alert tcp any any -> $HOME_NET 21 (msg:"FTP brute force detected"; flags:S; threshold:type threshold, track by_src, count 8, seconds 20; sid:1001030; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"SSH brute force detected"; flags:S; threshold:type threshold, track by_src, count 8, seconds 20; sid:1001031; rev:1;)
alert tcp any any -> $HOME_NET 23 (msg:"Telnet brute force detected"; flags:S; threshold:type threshold, track by_src, count 5, seconds 10; sid:1002; rev:2;)

# HTTP DoS / web abuse
alert tcp any any -> $HOME_NET 80 (msg:"HTTP flood detected"; flags:S; threshold:type threshold, track by_src, count 40, seconds 10; sid:1001040; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"SQL injection OR 1=1"; content:"or+1%3D1"; nocase; sid:1003; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"SQL injection OR 1 equals 1"; content:"or"; nocase; content:"1=1"; nocase; distance:0; within:80; sid:1001041; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"SQL injection union select"; content:"union"; nocase; content:"select"; nocase; distance:0; within:120; sid:1004; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"SQLmap scan detected"; content:"sqlmap"; nocase; sid:1005; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"Web XSS attempt detected"; content:"<script"; nocase; sid:1001042; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"Command injection attempt detected"; content:"/bin/sh"; nocase; sid:1001043; rev:1;)
